rules_version = '2';
// Solo la lista pública de spam se puede leer; nadie puede escribir desde la app (la publica la función programada).
service firebase.storage {
  match /b/{bucket}/o {
    match /spam_list.json {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
